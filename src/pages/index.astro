---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { formatDate, postPath } from '../lib/site';

const posts = await getPosts();
---

<BaseLayout home>
  {posts.length === 0 ? (
    <p class="empty">还没有文章。</p>
  ) : (
    <ul class="post-list" aria-label="文章列表">
      {posts.map((post) => {
        const summary = post.data.description?.trim();
        const { listImage } = post.data;
        return (
          <li class:list={{ 'post-list-with-image': listImage }}>
            <div class="post-list-text">
              <a href={postPath(post.id)}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              {summary && <p class="post-list-summary">{summary}</p>}
            </div>
            {listImage && (
              <Image
                class="post-list-image"
                src={listImage.src}
                alt={listImage.alt}
                loading="lazy"
                decoding="async"
              />
            )}
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>

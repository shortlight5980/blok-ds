---
import { render, type CollectionEntry } from 'astro:content';
import { AUTHOR, AUTHOR_JOB_DIRECTION, AUTHOR_TAGLINE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, url } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const authorDetails = [AUTHOR_TAGLINE, AUTHOR_JOB_DIRECTION && `求职方向：${AUTHOR_JOB_DIRECTION}`]
  .filter(Boolean)
  .join(' · ');
---

<BaseLayout title={post.data.title} description={post.data.description} type="article" header={false}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <p class="post-byline">
        <span>作者：{AUTHOR}</span>
        <a href={url('/')}>返回首页</a>
      </p>
      {authorDetails && <p class="post-author-details">{authorDetails}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>

    <p class="post-back"><a href={url('/')}>← 返回文章列表</a></p>
  </article>
</BaseLayout>

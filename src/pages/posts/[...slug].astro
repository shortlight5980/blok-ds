---
import { render, type CollectionEntry } from 'astro:content';
import { AUTHOR, AUTHOR_TAGLINE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, url } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article" header={false}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <p class="post-byline">
        <span>作者：{AUTHOR}</span>
        <a href={url('/')}>返回首页</a>
      </p>
      <p class="post-author-tagline">{AUTHOR_TAGLINE}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <p class="post-back"><a href={url('/')}>← 返回文章列表</a></p>
  </article>
</BaseLayout>

<script>
  for (const code of document.querySelectorAll('.prose pre > code')) {
    const pre = code.parentElement!;
    const source = pre.parentElement?.dataset.codeSource;
    let tools = pre.previousElementSibling;

    // 手写 HTML 的代码块直接从 <code> 读取，Markdown 块已有工具栏。
    if (!tools?.classList.contains('code-block-tools')) {
      const block = document.createElement('div');
      block.className = 'code-block';
      tools = document.createElement('div');
      tools.className = 'code-block-tools';
      const languageClass = [...code.classList].find((name) => name.startsWith('language-'));
      const language = languageClass?.slice('language-'.length) || pre.dataset.language;
      if (language) {
        const label = document.createElement('span');
        label.className = 'code-block-language';
        label.textContent = language;
        tools.append(label);
      }
      pre.before(block);
      block.append(tools, pre);
    }

    const status = document.createElement('span');
    status.className = 'code-block-status';
    status.setAttribute('role', 'status');

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-block-copy';
    button.textContent = '复制代码';
    button.addEventListener('click', async () => {
      status.textContent = '';
      try {
        const text = source === undefined ? code.textContent ?? '' : JSON.parse(source);
        await navigator.clipboard.writeText(text);
        status.textContent = '已复制';
      } catch {
        status.textContent = '复制失败，请手动复制';
      }
    });
    tools.append(status, button);
  }
</script>

---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_LANG, AUTHOR } from '../consts';
import ThemeToggle from '../components/ThemeToggle.astro';
import { url } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** 目录页（首页）把站点名作为页面标题，并显示站点简介。 */
  home?: boolean;
  /** 文章页隐藏站点页头，直接从文章标题开始。 */
  header?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  type = 'website',
  home = false,
  header = true,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const rssUrl = new URL(url('/rss.xml'), Astro.site ?? Astro.url);
const ogImageUrl = new URL(url('/og-image.png'), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('blok-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme;
          }
        } catch {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_TITLE} />
    {!noindex && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:alt" content={SITE_TITLE} />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class={header ? 'site' : 'site site--no-header'}>
      {header ? (
        <header class="site-header">
          <div class="site-identity">
            {home ? (
              <h1 class="site-title">{SITE_TITLE}</h1>
            ) : (
              <a class="site-title" href={url('/')}>{SITE_TITLE}</a>
            )}
            <p class="site-description">{SITE_DESCRIPTION}</p>
          </div>
          <nav aria-label="站点导航">
            <a href={url('/')}>文章</a>
            <a href={url('/rss.xml')}>RSS</a>
            <ThemeToggle />
          </nav>
        </header>
      ) : (
        <div class="site-toolbar">
          <ThemeToggle />
        </div>
      )}

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
        <a href={url('/rss.xml')}>RSS</a>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('[data-theme-toggle]');
        const label = toggle?.querySelector('[data-theme-toggle-label]');
        const media = window.matchMedia('(prefers-color-scheme: dark)');

        if (!toggle) return;

        const getTheme = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

        const updateToggle = () => {
          const isDark = getTheme() === 'dark';
          toggle.setAttribute('aria-label', '夜间模式');
          toggle.setAttribute('aria-pressed', String(isDark));
          toggle.setAttribute('title', '夜间模式');
          if (label) label.textContent = isDark ? '夜间模式' : '浅色模式';
        };

        toggle.addEventListener('click', () => {
          const theme = getTheme() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = theme;
          try {
            localStorage.setItem('blok-theme', theme);
          } catch {}
          updateToggle();
        });

        updateToggle();
        media.addEventListener('change', () => {
          if (!root.dataset.theme) updateToggle();
        });
        toggle.hidden = false;
      })();
    </script>
  </body>
</html>
